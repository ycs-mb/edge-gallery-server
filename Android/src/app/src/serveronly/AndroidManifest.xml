<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for binding to the Google AI Core service (Gemini Nano on-device). -->
    <uses-permission android:name="com.google.android.apps.aicore.service.BIND_SERVICE" />

    <application
        android:label="@string/server_app_name"
        tools:replace="android:label">
        <!--
          ServerLauncherActivity is the only entry point for the standalone server APK.
          It lets the user pick an AICore model (Gemini Nano), download it if needed,
          and start/stop the embedded HTTP server.
        -->
        <activity
            android:name="com.google.ai.edge.gallery.serveronly.ServerLauncherActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Gallery"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
